---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Caminho da imagem de compartilhamento, relativo a /public. */
  image?: string;
}

const {
  title = "Landingbase",
  description = "",
  image = "/og.jpg",
} = Astro.props;

// Só emite canonical absoluto quando `site` estiver definido no astro.config.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

// OG/Twitter exigem URL absoluta — só emite quando `site` estiver configurado.
const ogImage = Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />

    <link
      rel="preload"
      href="/fonts/neue-montreal-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&display=swap"
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <slot />
  </body>
</html>
