---
// Circular gallery: os cards correm ao longo de um arco, em loop infinito.
// Mesma ideia da CircularGallery do ReactBits (bend, raio, easing), mas em DOM
// e dirigida pelo SCROLL do palco — não pelo arrasto do mouse — e sem WebGL.
interface Props {
  /** curvatura do arco: 0 = reta, 1 = curva cheia */
  bend?: number;
  /** raio dos cantos, em fração da largura do card */
  borderRadius?: number;
  /** quanto o movimento persegue o scroll: menor = mais preguiçoso */
  scrollEase?: number;
  /** multiplicador do avanço por unidade de scroll */
  scrollSpeed?: number;
}

const {
  bend = 1,
  borderRadius = 0.05,
  scrollEase = 0.05,
  scrollSpeed = 2,
} = Astro.props;

const projetos = [
  { nome: "The Basic", tipo: "Moda" },
  { nome: "Orbis", tipo: "Indústria" },
  { nome: "Mister N's", tipo: "Serviço" },
  { nome: "Em breve", tipo: "—" },
  { nome: "Em breve", tipo: "—" },
  { nome: "Em breve", tipo: "—" },
];
---

<div
  class="galeria"
  data-bend={bend}
  data-ease={scrollEase}
  data-velocidade={scrollSpeed}
  style={`--raio: ${borderRadius}`}
>
  <p class="galeria__titulo">Projetos</p>

  <div class="galeria__palco">
    {
      projetos.map((projeto, i) => (
        <article class="galeria__item" data-i={i}>
          <div class="galeria__card">
            <span class="galeria__n">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <p class="galeria__legenda">
            <span>{projeto.nome}</span>
            <span class="galeria__tipo">{projeto.tipo}</span>
          </p>
        </article>
      ))
    }
  </div>
</div>

<script>
  const galeria = document.querySelector<HTMLElement>(".galeria");
  const itens = [...document.querySelectorAll<HTMLElement>(".galeria__item")];
  const palco = document.querySelector<HTMLElement>(".palco");

  const querMenosMovimento = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (galeria && palco && itens.length && !querMenosMovimento) {
    const bend = Number(galeria.dataset.bend ?? 1);
    const ease = Number(galeria.dataset.ease ?? 0.05);
    const velocidade = Number(galeria.dataset.velocidade ?? 2);

    // posição de cada card ao longo da faixa, em larguras de card
    const vao = () => itens[0].offsetWidth * 1.28;

    let alvo = 0;
    let atual = 0;

    // progresso do palco: 0 quando ele encosta no topo, 1 quando termina
    const progressoDoPalco = () => {
      const r = palco.getBoundingClientRect();
      const curso = palco.offsetHeight - window.innerHeight;
      if (curso <= 0) return 0;
      return Math.min(Math.max(-r.top / curso, 0), 1);
    };

    const quadro = () => {
      // a galeria só começa a girar depois que a faixa terminou de entrar
      const p = Math.max((progressoDoPalco() - 0.55) / 0.45, 0);
      alvo = p * velocidade * vao() * itens.length;

      // scrollEase: o movimento persegue o alvo em vez de colar nele
      atual += (alvo - atual) * ease;

      const largura = vao() * itens.length;
      const meio = galeria.clientWidth / 2;

      for (const item of itens) {
        const i = Number(item.dataset.i);

        // loop infinito: a posição dá a volta na faixa
        let x = (i * vao() - atual) % largura;
        if (x < 0) x += largura;
        x -= vao();

        // arco: a distância do centro empurra o card para baixo e o inclina
        const d = (x + item.offsetWidth / 2 - meio) / meio;
        const y = bend * d * d * (galeria.clientHeight * 0.12);
        const giro = bend * d * 5;

        item.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${giro}deg)`;
      }

      requestAnimationFrame(quadro);
    };

    requestAnimationFrame(quadro);
  }
</script>

<style>
  .galeria {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    height: 100%;
    width: 100vw;
    padding-inline: clamp(1.5rem, 6vw, 5rem);
    overflow: hidden;
  }

  .galeria__titulo {
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(13, 11, 10, 0.55);
  }

  .galeria__palco {
    position: relative;
    height: clamp(18rem, 52vh, 30rem);
  }

  .galeria__item {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(11rem, 20vw, 17rem);
    will-change: transform;
  }

  .galeria__card {
    display: grid;
    place-items: end start;
    aspect-ratio: 3 / 4;
    padding: 1rem;
    border-radius: calc(var(--raio, 0.05) * 100%);
    background: linear-gradient(160deg, #e7e2d8, #d3ccc0);
    box-shadow: 0 18px 40px rgba(13, 11, 10, 0.12);
  }

  .galeria__n,
  .galeria__legenda {
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .galeria__n {
    color: rgba(13, 11, 10, 0.55);
  }

  .galeria__legenda {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.85rem 0 0;
  }

  .galeria__tipo {
    color: rgba(13, 11, 10, 0.5);
  }

  /* Sem movimento: os cards viram uma faixa rolável comum. */
  @media (prefers-reduced-motion: reduce) {
    .galeria__palco {
      height: auto;
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
    }

    .galeria__item {
      position: static;
      flex: 0 0 auto;
    }
  }
</style>
