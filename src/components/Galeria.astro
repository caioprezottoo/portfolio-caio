---
// Galeria circular: a faixa de projetos desfila em arco — os cards das pontas
// descem e giram, os do centro sobem, como se estivessem na borda de uma roda.
// Os cards são placeholders até entrarem os projetos reais.
const projetos = [
  { n: "01", nome: "The Basic", tipo: "Moda" },
  { n: "02", nome: "Orbis", tipo: "Indústria" },
  { n: "03", nome: "Mister N's", tipo: "Serviço" },
  { n: "04", nome: "Em breve", tipo: "—" },
  { n: "05", nome: "Em breve", tipo: "—" },
  { n: "06", nome: "Em breve", tipo: "—" },
];
---

<div class="galeria">
  <p class="galeria__titulo">Projetos</p>

  <ul class="galeria__faixa">
    {
      projetos.map((projeto, i) => (
        <li class="galeria__item" style={`--i: ${i}; --meio: 2.5`}>
          <div class="galeria__card">
            <span class="galeria__n">{projeto.n}</span>
          </div>
          <p class="galeria__legenda">
            <span class="galeria__nome">{projeto.nome}</span>
            <span class="galeria__tipo">{projeto.tipo}</span>
          </p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .galeria {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    height: 100%;
    padding-inline: clamp(1.5rem, 6vw, 5rem);
  }

  .galeria__titulo {
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(13, 11, 10, 0.55);
  }

  .galeria__faixa {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* o arco: quanto mais longe do meio, mais o card desce e gira */
  .galeria__item {
    --dist: max(calc(var(--i) - var(--meio)), calc(var(--meio) - var(--i)));
    flex: 0 0 auto;
    translate: 0 calc(var(--dist) * var(--dist) * 0.5rem);
    rotate: calc((var(--i) - var(--meio)) * 0.9deg);
  }

  .galeria__card {
    position: relative;
    display: grid;
    place-items: end start;
    width: clamp(11rem, 20vw, 17rem);
    aspect-ratio: 3 / 4;
    padding: 1rem;
    border-radius: 14px;
    background: linear-gradient(160deg, #e7e2d8, #d3ccc0);
    box-shadow: 0 18px 40px rgba(13, 11, 10, 0.12);
  }

  .galeria__n {
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(13, 11, 10, 0.55);
  }

  .galeria__legenda {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.85rem 0 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .galeria__tipo {
    color: rgba(13, 11, 10, 0.5);
  }
</style>
