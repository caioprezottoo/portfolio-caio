---
import { Image } from "astro:assets";
import barbershop from "../assets/cases/barbershop.jpg";
import orbis from "../assets/cases/orbis.jpg";
import thebasic from "../assets/cases/thebasic.jpg";

const cases = [
  {
    img: thebasic,
    alt: "Boné da The Basic fotografado em três quartos, luz de estúdio",
    nome: "The Basic",
    tipo: "Moda / streetwear",
    entrega:
      "Catálogo 360º do produto, vídeo de campanha e landing page publicada.",
    link: "https://the-basic-astro-2.vercel.app",
    linkLabel: "Ver o site",
  },
  {
    img: orbis,
    alt: "Folhas impressas sendo conferidas na gráfica da Orbis",
    nome: "Orbis",
    tipo: "Marca / produto",
    entrega:
      "Filme de marca em 16:9 a partir de captação simples e site institucional no ar.",
    link: "https://orbis-liart-seven.vercel.app",
    linkLabel: "Ver o site",
  },
  {
    img: barbershop,
    alt: "Cena de campanha da Mister N's Barbershop",
    nome: "Mister N's Barbershop",
    tipo: "Serviço local",
    entrega:
      "Campanha visual completa — cenas de atendimento e vídeo para redes, sem set nem elenco.",
    link: null,
    linkLabel: null,
  },
];
---

<section class="cases" id="trabalhos" aria-labelledby="cases-title">
  <div class="wrap">
    <p class="eyebrow">Trabalhos</p>
    <h2 id="cases-title" class="cases__title">
      Três marcas, do conceito ao que o cliente vê.
    </h2>

    <ul class="cases__grid">
      {
        cases.map((c) => (
          <li class="case">
            <Image
              class="case__img"
              src={c.img}
              alt={c.alt}
              widths={[420, 840]}
              sizes="(min-width: 900px) 33vw, 100vw"
              loading="lazy"
            />
            <div class="case__body">
              <p class="eyebrow">{c.tipo}</p>
              <h3 class="case__nome">{c.nome}</h3>
              <p class="case__entrega">{c.entrega}</p>
              {c.link && (
                <a class="case__link" href={c.link} rel="noopener">
                  {c.linkLabel} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cases {
    padding-block: var(--section-y);
  }

  .cases__title {
    font-size: var(--step-h2);
    max-width: 20ch;
    margin-top: 0.75rem;
  }

  .cases__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .case__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
    background: var(--paper-2);
  }

  .case__body {
    padding-top: 1.25rem;
  }

  .case__nome {
    font-size: var(--step-h3);
    margin-top: 0.35rem;
  }

  .case__entrega {
    margin-top: 0.6rem;
    color: var(--ink-2);
    font-size: 1rem;
  }

  .case__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
