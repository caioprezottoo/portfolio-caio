---
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="wrap rodape__inner">
    <p>Caio Prezotto — direção criativa e produção.</p>
    <p>© {ano}</p>
  </div>
</footer>

<style>
  .rodape {
    padding-block: 2rem;
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  .rodape__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
  }

  .rodape p {
    margin: 0;
  }
</style>
