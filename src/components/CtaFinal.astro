---
import { WHATSAPP_URL, AGENDA_URL, EMAIL_URL, EMAIL } from "../data/contato";
---

<section class="cta" id="contato" aria-labelledby="cta-title">
  <div class="wrap cta__inner">
    <p class="eyebrow cta__eyebrow">Vamos conversar</p>
    <h2 id="cta-title" class="cta__title">
      Me conta a marca. Eu te digo o que dá pra fazer.
    </h2>
    <p class="cta__lead">
      Resposta no mesmo dia útil. A primeira conversa não custa nada e já sai
      dela uma direção — mesmo que você não feche.
    </p>

    <div class="cta__actions">
      <a class="btn btn--primary" href={WHATSAPP_URL} rel="noopener">
        Chamar no WhatsApp
      </a>
      <a class="btn btn--ghost cta__ghost" href={AGENDA_URL} rel="noopener">
        Agendar call de 30 min
      </a>
      <a class="btn btn--ghost cta__ghost" href={EMAIL_URL}>
        Escrever por e-mail
      </a>
    </div>

    <p class="cta__email">
      Ou direto: <a href={EMAIL_URL}>{EMAIL}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
    background: var(--ink);
    color: var(--paper);
  }

  .cta__inner {
    text-align: center;
  }

  .cta__eyebrow {
    color: #b9b0a3;
  }

  .cta__title {
    font-size: var(--step-h2);
    margin: 0.75rem auto 0;
    max-width: 20ch;
  }

  .cta__lead {
    margin: 1.25rem auto 0;
    max-width: 52ch;
    color: #cdc5b8;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .cta__ghost {
    color: var(--paper);
    border-color: #4d463d;
  }

  .cta__ghost:hover {
    background: #241f19;
    border-color: var(--paper);
  }

  .cta__email {
    margin-top: 2rem;
    font-size: var(--step-small);
    color: #b9b0a3;
  }

  .cta__email a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-underline-offset: 4px;
  }
</style>
