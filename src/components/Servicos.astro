---
const itens = [
  {
    n: "01",
    titulo: "Conceito e identidade",
    texto:
      "O ângulo da marca antes do pixel: promessa, tom de voz, paleta e sistema tipográfico. Sai um guia curto que qualquer peça futura respeita.",
  },
  {
    n: "02",
    titulo: "Imagem e vídeo de campanha",
    texto:
      "Produto, cena e filme produzidos sem set, elenco ou diária de produtora. Você recebe os arquivos prontos para feed, anúncio e site.",
  },
  {
    n: "03",
    titulo: "Site publicado",
    texto:
      "Landing page estática, rápida e acessível, no ar em domínio próprio. Sem construtor, sem mensalidade de plataforma.",
  },
];
---

<section class="serv" id="servicos" aria-labelledby="serv-title">
  <div class="wrap">
    <p class="eyebrow">O que você recebe</p>
    <h2 id="serv-title" class="serv__title">
      Um pacote fechado — não três fornecedores.
    </h2>

    <ul class="serv__list">
      {
        itens.map((i) => (
          <li class="serv__item">
            <span class="serv__n" aria-hidden="true">
              {i.n}
            </span>
            <div>
              <h3 class="serv__h3">{i.titulo}</h3>
              <p class="serv__p">{i.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .serv {
    padding-block: var(--section-y);
    background: var(--paper-2);
    border-block: 1px solid var(--rule);
  }

  .serv__title {
    font-size: var(--step-h2);
    max-width: 18ch;
    margin-top: 0.75rem;
  }

  .serv__list {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (min-width: 60rem) {
    .serv__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .serv__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .serv__n {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .serv__h3 {
    font-size: var(--step-h3);
  }

  .serv__p {
    margin-top: 0.6rem;
    color: var(--ink-2);
    font-size: 1rem;
    max-width: 40ch;
  }
</style>
