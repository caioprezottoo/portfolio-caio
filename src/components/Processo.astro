---
import { AGENDA_URL } from "../data/contato";

const passos = [
  {
    t: "Conversa de 30 minutos",
    d: "Você mostra a marca e o objetivo. Eu digo o que faria e quanto custa. Sem proposta de 20 páginas.",
  },
  {
    t: "Direção aprovada antes da produção",
    d: "Conceito, referências e paleta em um documento curto. Nada é produzido antes do seu sim.",
  },
  {
    t: "Produção e entrega",
    d: "Imagens, vídeos e o site publicado. Arquivos abertos na sua mão, sem depender de mim para o próximo post.",
  },
];
---

<section class="proc" id="processo" aria-labelledby="proc-title">
  <div class="wrap proc__inner">
    <div>
      <p class="eyebrow">Como funciona</p>
      <h2 id="proc-title" class="proc__title">Três passos, sem mistério.</h2>
      <a class="btn btn--ghost proc__cta" href={AGENDA_URL} rel="noopener">
        Começar pela conversa
      </a>
    </div>

    <ol class="proc__list">
      {
        passos.map((p) => (
          <li class="proc__item">
            <h3 class="proc__h3">{p.t}</h3>
            <p class="proc__p">{p.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc {
    padding-block: var(--section-y);
  }

  .proc__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  @media (min-width: 60rem) {
    .proc__inner {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .proc__title {
    font-size: var(--step-h2);
    margin-top: 0.75rem;
  }

  .proc__cta {
    margin-top: 1.75rem;
  }

  .proc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
    display: grid;
    gap: 1.75rem;
  }

  .proc__item {
    counter-increment: passo;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .proc__h3 {
    font-size: var(--step-h3);
  }

  .proc__h3::before {
    content: counter(passo, decimal-leading-zero);
    font-family: var(--sans);
    font-size: var(--step-small);
    color: var(--accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .proc__p {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 1rem;
    max-width: 52ch;
  }
</style>
