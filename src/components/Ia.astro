---
import { Image } from "astro:assets";
import barbeariaAntes from "../assets/ia/barbearia-antes.jpg";
import barbeariaDepois from "../assets/ia/barbearia-depois.jpg";
import capAntes from "../assets/ia/cap-antes.jpg";
import capDepois from "../assets/ia/cap-depois.jpg";
import orbisAntes from "../assets/ia/orbis-antes.jpg";
import orbisDepois from "../assets/ia/orbis-depois.jpg";

// Seção de publicidade com IA: cada bloco mostra o material de origem e o
// resultado. Fundo escuro pontilhado e um "Built by me." curvo atravessando o
// fundo com opacidade baixa — é profundidade, não leitura.
const comparacoes = [
  {
    cliente: "Mister N’s",
    oQue: "Cena de atendimento",
    antes: {
      img: barbeariaAntes,
      alt: "Salão da barbearia vazio, foto do próprio cliente",
      rotulo: "Foto do salão",
    },
    depois: {
      img: barbeariaDepois,
      alt: "Barbeiro atendendo um cliente na mesma barbearia",
      rotulo: "Resultado",
    },
    nota: "Sem set, sem elenco, sem diária de produção.",
  },
  {
    cliente: "The Basic",
    oQue: "Produto em estúdio",
    antes: {
      img: capAntes,
      alt: "Boné de referência usado como base",
      rotulo: "Referência",
    },
    depois: {
      video: "/videos/ia-cap.mp4",
      alt: "Filme de campanha do boné da The Basic",
      rotulo: "Resultado",
    },
    nota: "Um boné vira catálogo de oito ângulos.",
  },
  {
    cliente: "Orbis",
    oQue: "Captação ampliada",
    antes: {
      video: "/videos/ia-orbis-antes.mp4",
      alt: "Vídeo original da gráfica, gravado no celular",
      rotulo: "Captação no celular",
    },
    depois: {
      video: "/videos/ia-orbis-depois.mp4",
      alt: "Mesmo plano estendido para widescreen",
      rotulo: "Resultado",
    },
    nota: "Vertical de celular vira widescreen de campanha.",
  },
];
---

<section class="ia" aria-labelledby="ia-titulo">
  <div class="ia__pontos" aria-hidden="true"></div>

  <div class="ia__curva" aria-hidden="true">
    <svg viewBox="0 0 1600 400" preserveAspectRatio="xMidYMid slice">
      <defs>
        <path id="arco" d="M -400 330 Q 800 60 2000 330" fill="none"></path>
      </defs>
      <text class="ia__curvaTexto">
        <textPath href="#arco" startOffset="0%">
          Built by me. Built by me. Built by me. Built by me. Built by me.
        </textPath>
      </text>
    </svg>
  </div>

  <div class="ia__interno">
    <header class="ia__cabecalho">
      <p class="ia__olho">Publicidade com IA</p>
      <h2 class="ia__titulo" id="ia-titulo">
        Além do site, eu produzo a campanha.
      </h2>
      <p class="ia__lead">
        O material de origem é o que o cliente já tem — uma foto do salão, um
        boné na mesa, um vídeo de celular. O que sai é peça de campanha.
      </p>
    </header>

    <ul class="ia__lista">
      {
        comparacoes.map((c) => (
          <li class="ia__bloco">
            <div class="ia__par">
              <figure class="ia__quadro">
                {c.antes.video ? (
                  <video
                    src={c.antes.video}
                    aria-label={c.antes.alt}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <Image
                    src={c.antes.img}
                    alt={c.antes.alt}
                    widths={[480, 960]}
                    sizes="(min-width: 60rem) 34vw, 88vw"
                    loading="lazy"
                  />
                )}
                <figcaption>{c.antes.rotulo}</figcaption>
              </figure>

              <span class="ia__seta" aria-hidden="true">→</span>

              <figure class="ia__quadro ia__quadro--resultado">
                {c.depois.video ? (
                  <video
                    src={c.depois.video}
                    aria-label={c.depois.alt}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  />
                ) : (
                  <Image
                    src={c.depois.img}
                    alt={c.depois.alt}
                    widths={[480, 960]}
                    sizes="(min-width: 60rem) 34vw, 88vw"
                    loading="lazy"
                  />
                )}
                <figcaption>{c.depois.rotulo}</figcaption>
              </figure>
            </div>

            <div class="ia__texto">
              <p class="ia__cliente">
                <span>{c.cliente}</span>
                <span class="ia__oque">{c.oQue}</span>
              </p>
              <p class="ia__nota">{c.nota}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ia {
    position: relative;
    isolation: isolate;
    background: #201f1d;
    color: #f4f0e8;
    padding-block: clamp(5rem, 14vh, 9rem);
    overflow: hidden;
  }

  /* bolinhas do fundo */
  .ia__pontos {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(
      rgba(244, 240, 232, 0.16) 1.2px,
      transparent 1.2px
    );
    background-size: 22px 22px;
    mask-image: radial-gradient(120% 90% at 50% 40%, #000 40%, transparent 100%);
  }

  /* o texto curvo atravessa o fundo, da esquerda para a direita */
  .ia__curva {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .ia__curva svg {
    width: 190%;
    height: auto;
  }

  .ia__curvaTexto {
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 96px;
    font-weight: 600;
    letter-spacing: 0.06em;
    fill: rgba(244, 240, 232, 0.07);
    animation: correr 26s linear infinite;
  }

  @keyframes correr {
    from {
      transform: translateX(-14%);
    }
    to {
      transform: translateX(14%);
    }
  }

  .ia__interno {
    position: relative;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 6vw, 5rem);
  }

  .ia__olho {
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 240, 232, 0.55);
  }

  .ia__titulo {
    margin: 0.9rem 0 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 4.4vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .ia__lead {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(244, 240, 232, 0.72);
  }

  .ia__lista {
    display: grid;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    margin: clamp(3rem, 8vh, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .ia__par {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .ia__quadro {
    margin: 0;
  }

  .ia__quadro img,
  .ia__quadro video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.72;
  }

  .ia__quadro--resultado img,
  .ia__quadro--resultado video {
    filter: none;
    opacity: 1;
  }

  .ia__quadro figcaption {
    margin-top: 0.6rem;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 240, 232, 0.5);
  }

  .ia__quadro--resultado figcaption {
    color: #ff5b2e;
  }

  .ia__seta {
    font-size: 1.5rem;
    color: rgba(244, 240, 232, 0.45);
  }

  .ia__texto {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 2rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(244, 240, 232, 0.16);
  }

  .ia__cliente {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .ia__oque {
    color: rgba(244, 240, 232, 0.55);
    font-weight: 400;
  }

  .ia__nota {
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.875rem;
    color: rgba(244, 240, 232, 0.6);
  }

  @media (max-width: 48rem) {
    .ia__par {
      grid-template-columns: 1fr;
    }

    .ia__seta {
      justify-self: center;
      rotate: 90deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia__curvaTexto {
      animation: none;
    }
  }
</style>
