---
import { Image } from "astro:assets";
import rasgo from "../assets/rasgo.jpg";

// Seção de força: a frase é a imagem. Composição assimétrica — linha cheia no
// topo, a foto ocupando a direita, duas linhas curtas à esquerda dela e a
// virada da frase embaixo, alinhada à direita.
---

<section class="forca" id="trabalhos" aria-labelledby="forca-titulo">

  <div class="forca__interno">
    <h2 class="forca__titulo" id="forca-titulo">
      <span class="forca__topo">
        <span class="forca__texto" style="--ordem: 0">
          Sites personalizados que
        </span>
      </span>

      <span class="forca__esq">
        <span class="forca__texto" style="--ordem: 1">cansaram</span>
        <span class="forca__texto" style="--ordem: 2">de passar</span>
      </span>

      <Image
        class="forca__foto"
        src={rasgo}
        alt=""
        widths={[394, 788]}
        sizes="(min-width: 48rem) 34vw, 78vw"
        loading="lazy"
      />

      <span class="forca__base">
        <span class="forca__texto forca__texto--destaque" style="--ordem: 3">
          <span class="forca__sr">despercebidos.</span>
          <span class="forca__troca" aria-hidden="true">despercebidos.</span>
        </span>
      </span>
    </h2>
  </div>
</section>

<script>
  // Arma o estado inicial só quando há JS e dispara a entrada uma única vez.
  const secao = document.querySelector<HTMLElement>(".forca");
  const querMenosMovimento = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (secao && !querMenosMovimento) {
    secao.classList.add("forca--armada");

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          secao.classList.add("forca--visivel");
          observador.disconnect();
        }
      },
      { threshold: 0.25 },
    );

    observador.observe(secao);
  }

  // Decrypted text: a última palavra embaralha e se resolve em outra, em loop.
  const troca = document.querySelector<HTMLElement>(".forca__troca");
  const palavras = [
    "despercebidos.",
    "sem cliques.",
    "em branco.",
    "esquecidos.",
    "batidos.",
  ];
  const ALFABETO = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&@$*<>/\\";

  if (troca && !querMenosMovimento) {
    let indice = 0;
    let quadro = 0;
    let fila: { de: string; para: string; inicio: number; fim: number }[] = [];
    let animando = false;

    const sortear = () =>
      ALFABETO[Math.floor(Math.random() * ALFABETO.length)];

    const desenhar = () => {
      let saida = "";
      let prontos = 0;

      for (const letra of fila) {
        if (quadro >= letra.fim) {
          prontos++;
          saida += letra.para;
        } else if (quadro >= letra.inicio) {
          saida += sortear();
        } else {
          saida += letra.de;
        }
      }

      troca.textContent = saida;

      if (prontos === fila.length) {
        animando = false;
        // segura a palavra resolvida antes de partir para a próxima
        setTimeout(proxima, 2200);
        return;
      }

      quadro++;
      requestAnimationFrame(desenhar);
    };

    const proxima = () => {
      if (animando) return;
      animando = true;

      const de = troca.textContent ?? "";
      indice = (indice + 1) % palavras.length;
      const para = palavras[indice];
      const tamanho = Math.max(de.length, para.length);

      fila = [];
      for (let i = 0; i < tamanho; i++) {
        const inicio = Math.floor(Math.random() * 18);
        fila.push({
          de: de[i] ?? "",
          para: para[i] ?? "",
          inicio,
          fim: inicio + Math.floor(Math.random() * 18) + 8,
        });
      }

      quadro = 0;
      requestAnimationFrame(desenhar);
    };

    // começa depois da entrada da seção
    const iniciar = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          setTimeout(proxima, 1600);
          iniciar.disconnect();
        }
      },
      { threshold: 0.25 },
    );

    if (secao) iniciar.observe(secao);
  }
</script>

<style>
  .forca {
    position: relative;
    background: transparent;
    color: #0d0b0a;
    padding-block: clamp(4rem, 11vh, 7.5rem);
    overflow: hidden;
  }


  .forca__interno {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 6vw, 5rem);
  }

  .forca__titulo {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 6.2vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  /* linha cheia atravessando as duas colunas */
  .forca__topo {
    grid-column: 1 / -1;
    display: block;
    white-space: nowrap;
  }

  /* as duas linhas curtas, à esquerda da foto */
  .forca__esq {
    grid-column: 1;
    display: block;
  }

  .forca__foto {
    grid-column: 2;
    width: clamp(12rem, 31vw, 23rem);
    height: auto;
    border-radius: 14px;
    /* recuada em relação ao texto: a linha de destaque passa da foto,
       como na referência */
    margin-right: clamp(0rem, 15vw, 12rem);
  }

  /* a virada da frase: embaixo, à direita e maior que o resto */
  .forca__base {
    grid-column: 1 / -1;
    display: block;
    text-align: right;
    font-size: 1.3em;
    margin-top: 0.05em;
  }

  .forca__texto {
    display: block;
  }

  /* Blur reveal: dispara UMA vez quando a seção entra em cena, e roda até o
     fim sozinha. Atrelar ao scroll (view timeline) deixava o texto preso no
     meio do foco enquanto se rola devagar, e desfocando de novo ao voltar.
     O estado inicial só é aplicado quando o script assume — sem JS o texto
     nasce nítido e visível. */
  .forca--armada .forca__texto {
    opacity: 0;
    translate: 0 18px;
    filter: blur(18px);
    will-change: filter, opacity;
  }

  .forca--visivel .forca__texto {
    animation: focar 0.9s cubic-bezier(0.22, 1, 0.36, 1)
      calc(var(--ordem, 0) * 0.11s) both;
  }

  .forca__texto--destaque {
    color: #ff3f0a;
  }

  /* o texto que os leitores de tela anunciam fica fixo; o que embaralha é
     decorativo */
  .forca__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .forca__troca {
    display: inline-block;
    white-space: pre;
  }

  @keyframes focar {
    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
  }

  /* Telas estreitas: tudo empilhado, a foto entre as linhas. */
  @media (max-width: 48rem) {
    .forca__titulo {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 0.75rem;
    }

    .forca__topo {
      white-space: normal;
    }

    .forca__foto {
      grid-column: 1;
      width: min(78vw, 20rem);
      justify-self: center;
      margin-block: 0.5rem;
    }

    .forca__base {
      text-align: left;
      font-size: 1.05em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .forca--armada .forca__texto,
    .forca--visivel .forca__texto {
      opacity: 1;
      translate: 0 0;
      filter: none;
      animation: none;
    }
  }
</style>
