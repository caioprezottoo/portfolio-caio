---
import { WHATSAPP_URL } from "../data/contato";

// Hero de tela cheia: o nome preenche a largura sobre o laranja, com glow
// pulsante. Na entrada cada linha "explode" de um ponto até o tamanho final,
// com duas cópias-fantasma atrás formando um rastro.
// Uma linha no desktop, duas em telas estreitas — alternância só por CSS.
const variantes = [
  { classe: "larga", linhas: ["CAIO PREZOTTO"] },
  { classe: "estreita", linhas: ["CAIO", "PREZOTTO"] },
];
---

<header class="hero">
  <div class="hero__nome">
    {
      variantes.map((v) => (
        <div class={`hero__variante hero__variante--${v.classe}`}>
          {v.linhas.map((linha, i) => (
            <svg
              class="hero__linha"
              viewBox="0 0 1000 200"
              role={v.classe === "larga" && i === 0 ? "img" : "presentation"}
              aria-label={
                v.classe === "larga" && i === 0 ? "Caio Prezotto" : undefined
              }
              aria-hidden={v.classe === "larga" && i === 0 ? undefined : "true"}
            >
              {/* rastro: duas cópias atrás, levemente atrasadas */}
              <text
                class="hero__texto hero__texto--t2"
                style={`--atraso: ${0.6 + i * 0.11}s`}
                x="500"
                y="160"
                text-anchor="middle"
                textLength="1000"
                lengthAdjust="spacingAndGlyphs"
                aria-hidden="true"
              >
                {linha}
              </text>
              <text
                class="hero__texto hero__texto--t1"
                style={`--atraso: ${0.55 + i * 0.11}s`}
                x="500"
                y="160"
                text-anchor="middle"
                textLength="1000"
                lengthAdjust="spacingAndGlyphs"
                aria-hidden="true"
              >
                {linha}
              </text>
              <text
                class="hero__texto hero__texto--solido"
                style={`--atraso: ${0.5 + i * 0.11}s`}
                x="500"
                y="160"
                text-anchor="middle"
                textLength="1000"
                lengthAdjust="spacingAndGlyphs"
              >
                {linha}
              </text>
            </svg>
          ))}
        </div>
      ))
    }
  </div>

  <nav class="hero__barra" aria-label="Atalhos">
    <ul class="hero__links">
      <li><a href="#trabalhos">Trabalhos</a></li>
      <li><a href="#servicos">Serviços</a></li>
      <li><a href="#processo">Processo</a></li>
    </ul>
    <a class="hero__cta" href={WHATSAPP_URL} rel="noopener">Começar um projeto</a>
  </nav>
</header>

<style>
  /* Registrar os raios como <length> permite interpolá-los na animação. */
  @property --glow-1 {
    syntax: "<length>";
    inherits: false;
    initial-value: 5px;
  }
  @property --glow-2 {
    syntax: "<length>";
    inherits: false;
    initial-value: 16px;
  }
  @property --glow-3 {
    syntax: "<length>";
    inherits: false;
    initial-value: 40px;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ff3f0a;
    overflow: hidden;
  }

  .hero__nome {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(0.5rem, 2vw, 2rem);
  }

  .hero__variante--estreita {
    display: none;
  }

  @media (max-width: 48rem) {
    .hero__variante--larga {
      display: none;
    }
    .hero__variante--estreita {
      display: block;
    }
  }

  .hero__linha {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    will-change: filter;
    --glow-1: 5px;
    --glow-2: 16px;
    --glow-3: 40px;
    filter: drop-shadow(0 0 var(--glow-1) rgba(255, 255, 255, 0.7))
      drop-shadow(0 0 var(--glow-2) rgba(255, 255, 255, 0.4))
      drop-shadow(0 0 var(--glow-3) rgba(255, 255, 255, 0.2));
    animation: glow 8.5s cubic-bezier(0.37, 0, 0.63, 1) 1.9s infinite;
  }

  .hero__texto {
    font-family: Anton, Impact, "Arial Black", "Helvetica Neue", sans-serif;
    font-size: 190px;
    font-weight: 400;
    fill: #f4f0e8;
    transform-box: fill-box;
    transform-origin: center;
    animation: expandir 0.82s cubic-bezier(0.16, 1.28, 0.3, 1) var(--atraso, 0.5s)
      both;
  }

  .hero__texto--solido {
    animation:
      surgir 0.22s ease-out both,
      expandir 0.82s cubic-bezier(0.16, 1.28, 0.3, 1) var(--atraso, 0.5s) both;
  }

  .hero__texto--t1 {
    animation:
      expandir 0.82s cubic-bezier(0.16, 1.28, 0.3, 1) var(--atraso) both,
      rastro 0.82s ease-out var(--atraso) both;
  }

  .hero__texto--t2 {
    animation:
      expandir 0.82s cubic-bezier(0.16, 1.28, 0.3, 1) var(--atraso) both,
      rastro-fraco 0.82s ease-out var(--atraso) both;
  }

  @keyframes glow {
    0%,
    100% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
    50% {
      --glow-1: 26px;
      --glow-2: 82px;
      --glow-3: 176px;
    }
  }

  @keyframes expandir {
    from {
      scale: 0.02;
    }
    to {
      scale: 1;
    }
  }

  @keyframes surgir {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes rastro {
    0% {
      opacity: 0;
    }
    20% {
      opacity: 0.34;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes rastro-fraco {
    0% {
      opacity: 0;
    }
    20% {
      opacity: 0.17;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__linha,
    .hero__texto {
      animation: none;
    }
    .hero__texto--t1,
    .hero__texto--t2 {
      display: none;
    }
  }

  .hero__barra {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 2rem);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__barra a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #f4f0e8;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__barra a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero__cta {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>
