---
// Hero de tela cheia: o nome preenche a largura sobre o laranja, com glow
// pulsante. Na entrada cada letra sobe de dentro da própria máscara
// (masked reveal) com overshoot, deixando um rastro fantasma para trás.
// No fim da sequência o conjunto dá um pulso de escala e o glow estoura:
// é o "soco" do impacto.
// Uma linha no desktop, duas em telas estreitas — alternância só por CSS.
// O nome fica colado na base do hero; nenhum outro texto divide a atenção.
const palavras = ["CAIO", "PREZOTTO"];

// Atraso acumulado por letra, contando as duas palavras em sequência.
let n = 0;
const linhas = palavras.map((palavra) => ({
  palavra,
  letras: [...palavra].map((letra) => ({ letra, ordem: n++ })),
}));
---

<header class="hero" style={`--total: ${n}`}>
  <div class="hero__nome">
    <p class="hero__sr">Caio Prezotto</p>

    <div class="hero__wordmark" aria-hidden="true">
      {
        linhas.map(({ palavra, letras }) => (
          <span class={`hero__palavra hero__palavra--${palavra.length}`}>
            {letras.map(({ letra, ordem }) => (
              <span class="hero__mascara">
                <span
                  class="hero__letra"
                  data-l={letra}
                  style={`--ordem: ${ordem}`}
                >
                  {letra}
                </span>
              </span>
            ))}
          </span>
        ))
      }
    </div>

    <a class="hero__scroll" href="#trabalhos">
      <span class="hero__scroll-texto">Ver trabalhos</span>
      <svg
        class="hero__scroll-seta"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
      >
        <path
          d="M12 4v15m0 0l-6-6m6 6l6-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>

</header>

<style>
  /* Registrar os raios como <length> permite interpolá-los na animação. */
  @property --glow-1 {
    syntax: "<length>";
    inherits: false;
    initial-value: 5px;
  }
  @property --glow-2 {
    syntax: "<length>";
    inherits: false;
    initial-value: 16px;
  }
  @property --glow-3 {
    syntax: "<length>";
    inherits: false;
    initial-value: 40px;
  }

  .hero {
    /* tempo da entrada, compartilhado pelo nome e pelo indicador de scroll */
    --inicio: 0.25s;
    --intervalo: 0.04s;
    --duracao: 0.86s;
    /* de quão longe abaixo cada letra vem: o suficiente para nascer fora da
       borda de baixo do hero, contando o respiro e o indicador de scroll */
    --distancia: 60svh;
    /* instante em que a última letra termina de assentar */
    --fim: calc(
      var(--inicio) + (var(--total, 12) - 1) * var(--intervalo) + var(--duracao)
    );
    --batida: calc(
      var(--inicio) + (var(--total, 12) - 1) * var(--intervalo) + var(--duracao) *
        0.55
    );
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ff3f0a;
    overflow: hidden;
  }

  .hero__nome {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    padding-bottom: clamp(3rem, 7vh, 5rem);
  }

  /* O nome legível fica só para leitores de tela; o desenho é decorativo. */
  .hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__wordmark {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 0.06em;
    font-family: Anton, Impact, "Arial Black", "Helvetica Neue", sans-serif;
    font-size: 20vw;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: #f4f0e8;
    --glow-1: 5px;
    --glow-2: 16px;
    --glow-3: 40px;
    filter: drop-shadow(0 0 var(--glow-1) rgba(255, 255, 255, 0.7))
      drop-shadow(0 0 var(--glow-2) rgba(255, 255, 255, 0.4))
      drop-shadow(0 0 var(--glow-3) rgba(255, 255, 255, 0.2));
    transform-origin: 50% 100%;
    animation:
      flash 0.9s cubic-bezier(0.33, 1, 0.68, 1) calc(var(--batida) - 0.08s)
        both,
      impacto 0.5s cubic-bezier(0.22, 1.4, 0.36, 1) var(--batida) both,
      glow 8.5s cubic-bezier(0.37, 0, 0.63, 1) calc(var(--batida) + 1s)
        infinite;
    will-change: filter, scale;
    margin-bottom: 0;
  }

  .hero__palavra {
    display: flex;
  }

  /* Quem mascara é o hero (overflow: hidden), não a caixa da letra: assim a
     letra sobe visível desde fora da borda de baixo, em vez de brotar da
     própria linha de base. */
  .hero__mascara {
    display: block;
    padding-bottom: 0.08em;
  }

  .hero__letra {
    display: block;
    position: relative;
    translate: 0 var(--distancia);
    /* overshoot: a letra passa do lugar e volta — é o que dá o soco */
    animation: revelar var(--duracao) cubic-bezier(0.16, 1.42, 0.32, 1)
      calc(var(--inicio) + var(--ordem) * var(--intervalo)) both;
  }

  /* rastro: um fantasma da própria letra que sobe atrás e some */
  .hero__letra::before {
    content: attr(data-l);
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: rastro var(--duracao) ease-out
      calc(var(--inicio) + 0.04s + var(--ordem) * var(--intervalo)) both;
  }

  @keyframes revelar {
    to {
      translate: 0 0;
    }
  }

  @keyframes rastro {
    0% {
      opacity: 0;
      translate: 0 60%;
    }
    25% {
      opacity: 0.34;
    }
    100% {
      opacity: 0;
      translate: 0 0;
    }
  }

  /* pulso do conjunto no instante em que a última letra assenta */
  @keyframes impacto {
    0% {
      scale: 1;
    }
    35% {
      scale: 1.028 0.972;
    }
    100% {
      scale: 1;
    }
  }

  /* estouro do glow junto do impacto */
  @keyframes flash {
    0% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
    30% {
      --glow-1: 34px;
      --glow-2: 104px;
      --glow-3: 210px;
    }
    100% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
  }

  @keyframes glow {
    0%,
    100% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
    50% {
      --glow-1: 26px;
      --glow-2: 82px;
      --glow-3: 176px;
    }
  }

  /* Telas estreitas: uma palavra por linha, cada uma preenchendo a largura. */
  @media (max-width: 48rem) {
    .hero__wordmark {
      flex-direction: column;
      align-items: stretch;
      font-size: 26vw;
      row-gap: 0.02em;
    }

    .hero__palavra {
      justify-content: space-between;
    }

    .hero__palavra--4 {
      font-size: 2.02em;
    }
  }

  .hero__scroll {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
    padding: 0.55rem 1.15rem;
    border: 1px solid rgba(244, 240, 232, 0.35);
    border-radius: 999px;
    color: #f4f0e8;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(2px);
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.55);
    box-shadow:
      0 0 0 rgba(255, 255, 255, 0),
      inset 0 0 14px rgba(255, 255, 255, 0.12);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
    opacity: 0;
    /* entra depois do soco, para não competir com ele */
    animation:
      surgir-scroll 0.6s ease-out calc(var(--fim) + 0.2s) both,
      brilho 3.2s ease-in-out calc(var(--fim) + 0.8s) infinite;
  }

  .hero__scroll:hover {
    border-color: rgba(244, 240, 232, 0.85);
    background: rgba(255, 255, 255, 0.12);
    box-shadow:
      0 0 26px rgba(255, 255, 255, 0.45),
      inset 0 0 18px rgba(255, 255, 255, 0.2);
  }

  @keyframes brilho {
    0%,
    100% {
      box-shadow:
        0 0 8px rgba(255, 255, 255, 0.16),
        inset 0 0 14px rgba(255, 255, 255, 0.1);
      border-color: rgba(244, 240, 232, 0.3);
    }
    50% {
      box-shadow:
        0 0 24px rgba(255, 255, 255, 0.42),
        inset 0 0 20px rgba(255, 255, 255, 0.22);
      border-color: rgba(244, 240, 232, 0.7);
    }
  }

  .hero__scroll-seta {
    animation: descer 2.4s ease-in-out calc(var(--fim) + 1s) infinite;
  }

  @keyframes surgir-scroll {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes descer {
    0%,
    60%,
    100% {
      translate: 0 0;
    }
    30% {
      translate: 0 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll,
    .hero__scroll-seta {
      animation: none;
      opacity: 1;
    }
    .hero__wordmark {
      animation: none;
    }
    .hero__letra {
      animation: none;
      translate: 0 0;
    }
    .hero__letra::before {
      content: none;
    }
  }

</style>
