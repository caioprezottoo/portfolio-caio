---
// Hero de tela cheia: o nome sobe da borda de baixo, letra a letra, e quando
// a última assenta o conjunto dá um soco — squash mais estouro de brilho.
//
// Sobre o brilho: animar o raio de um drop-shadow custa uma repintura da tela
// inteira por frame (com 12 letras isso derrubava a página para ~26fps). Aqui
// o halo é uma cópia borrada do nome, com blur FIXO, e só a opacidade dela
// anima — opacidade é composta na GPU e sai de graça.
const palavras = ["CAIO", "PREZOTTO"];

let n = 0;
const linhas = palavras.map((palavra) => ({
  palavra,
  letras: [...palavra].map((letra) => ({ letra, ordem: n++ })),
}));
const total = n;
---

<header class="hero" style={`--total: ${total}`}>
  <div class="hero__nome">
    <p class="hero__sr">Caio Prezotto</p>

    <div class="hero__stack" aria-hidden="true">
      {
        ["halo", "brilho", "solido"].map((camada) => (
          <div class={`hero__wordmark hero__wordmark--${camada}`}>
            {linhas.map(({ palavra, letras }) => (
              <span class={`hero__palavra hero__palavra--${palavra.length}`}>
                {letras.map(({ letra, ordem }) => (
                  <span class="hero__mascara">
                    <span class="hero__letra" style={`--ordem: ${ordem}`}>
                      {letra}
                    </span>
                  </span>
                ))}
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <a class="hero__scroll" href="#trabalhos">
      <svg
        class="hero__scroll-seta"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
      >
        <path
          d="M12 4v15m0 0l-6-6m6 6l6-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="hero__scroll-texto">Ver trabalhos</span>
    </a>
  </div>
</header>

<style>
  .hero {
    /* tempo da entrada, compartilhado pelo nome, pelo soco e pelo indicador */
    --inicio: 0.25s;
    --intervalo: 0.04s;
    --duracao: 0.86s;
    --distancia: 60svh;
    /* instante em que a última letra termina de assentar */
    --fim: calc(
      var(--inicio) + (var(--total, 12) - 1) * var(--intervalo) + var(--duracao)
    );
    /* instante em que a última letra bate na posição */
    --batida: calc(
      var(--inicio) + (var(--total, 12) - 1) * var(--intervalo) + var(--duracao) *
        0.55
    );

    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ff3f0a;
    overflow: hidden;
  }

  .hero__nome {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    padding-bottom: clamp(3rem, 7vh, 5rem);
  }

  /* O nome legível fica só para leitores de tela; o desenho é decorativo. */
  .hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* as duas camadas ocupam o mesmo lugar */
  .hero__stack {
    position: relative;
  }

  .hero__wordmark {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 0.06em;
    font-family: Anton, Impact, "Arial Black", "Helvetica Neue", sans-serif;
    font-size: 20vw;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: #f4f0e8;
    animation: impacto 0.5s cubic-bezier(0.22, 1.4, 0.36, 1) var(--batida) both;
    transform-origin: 50% 100%;
  }

  /* Sombra: duas cópias borradas atrás do nome — uma justa, uma espalhada.
     O blur é FIXO (só a opacidade anima), então custa uma rasterização e não
     uma repintura por frame. */
  .hero__wordmark--halo,
  .hero__wordmark--brilho {
    position: absolute;
    inset: 0;
    will-change: opacity;
    animation:
      impacto 0.5s cubic-bezier(0.22, 1.4, 0.36, 1) var(--batida) both,
      flash 1.1s cubic-bezier(0.33, 1, 0.68, 1) calc(var(--batida) - 0.08s) both,
      respirar 8.5s cubic-bezier(0.37, 0, 0.63, 1) calc(var(--batida) + 1.1s)
        infinite;
  }

  /* a justa dá o contorno aceso */
  .hero__wordmark--brilho {
    filter: blur(0.045em);
    opacity: 0.85;
  }

  /* a espalhada dá o brilho no ar em volta */
  .hero__wordmark--halo {
    filter: blur(0.22em);
    opacity: 0.7;
  }

  .hero__palavra {
    display: flex;
  }

  /* Quem mascara é o hero (overflow: hidden), não a caixa da letra: assim a
     letra sobe visível desde fora da borda de baixo. */
  .hero__mascara {
    display: block;
    padding-bottom: 0.08em;
  }

  .hero__letra {
    display: block;
    translate: 0 var(--distancia);
    /* overshoot: a letra passa do lugar e volta — é o que dá o soco */
    animation: revelar var(--duracao) cubic-bezier(0.16, 1.42, 0.32, 1)
      calc(var(--inicio) + var(--ordem) * var(--intervalo)) both;
  }

  @keyframes revelar {
    to {
      translate: 0 0;
    }
  }

  @keyframes impacto {
    0% {
      scale: 1;
    }
    35% {
      scale: 1.028 0.972;
    }
    100% {
      scale: 1;
    }
  }

  /* estouro do halo no instante do soco */
  @keyframes flash {
    0% {
      opacity: 0.6;
      scale: 1;
    }
    18% {
      opacity: 1;
      scale: 1.045;
    }
    100% {
      opacity: 0.75;
      scale: 1;
    }
  }

  @keyframes respirar {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .hero__scroll {
    align-self: center;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    margin-top: clamp(1.25rem, 3vh, 2.25rem);
    color: #f4f0e8;
    font-family: "Neue Montreal", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: opacity 0.3s ease;
    opacity: 0;
    animation: surgir-scroll 0.6s ease-out calc(var(--fim) + 0.2s) both;
  }

  .hero__scroll:hover {
    opacity: 0.72;
  }

  .hero__scroll-seta {
    animation: descer 2.4s ease-in-out calc(var(--fim) + 1s) infinite;
  }

  @keyframes surgir-scroll {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes descer {
    0%,
    60%,
    100% {
      translate: 0 0;
    }
    30% {
      translate: 0 4px;
    }
  }

  /* Telas estreitas: uma palavra por linha, cada uma preenchendo a largura. */
  @media (max-width: 48rem) {
    .hero__wordmark {
      flex-direction: column;
      align-items: stretch;
      font-size: 26vw;
      row-gap: 0.02em;
    }

    .hero__palavra {
      justify-content: space-between;
    }

    .hero__palavra--4 {
      font-size: 2.02em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__wordmark,
    .hero__wordmark--brilho,
    .hero__letra,
    .hero__scroll,
    .hero__scroll-seta {
      animation: none;
    }
    .hero__letra {
      translate: 0 0;
    }
    .hero__scroll {
      opacity: 1;
    }
  }
</style>
