---
// Hero de tela cheia: o nome preenche a largura sobre o laranja, com glow
// pulsante. Na entrada cada letra sobe de dentro da própria máscara
// (masked reveal) com overshoot, deixando um rastro fantasma para trás.
// No fim da sequência o conjunto dá um pulso de escala e o glow estoura:
// é o "soco" do impacto.
// Uma linha no desktop, duas em telas estreitas — alternância só por CSS.
// O nome fica colado na base do hero; nenhum outro texto divide a atenção.
const palavras = ["CAIO", "PREZOTTO"];

// Atraso acumulado por letra, contando as duas palavras em sequência.
let n = 0;
const linhas = palavras.map((palavra) => ({
  palavra,
  letras: [...palavra].map((letra) => ({ letra, ordem: n++ })),
}));
---

<header class="hero">
  <div class="hero__nome">
    <p class="hero__sr">Caio Prezotto</p>

    <div class="hero__wordmark" aria-hidden="true">
      {
        linhas.map(({ palavra, letras }) => (
          <span class={`hero__palavra hero__palavra--${palavra.length}`}>
            {letras.map(({ letra, ordem }) => (
              <span class="hero__mascara">
                <span
                  class="hero__letra"
                  data-l={letra}
                  style={`--ordem: ${ordem}`}
                >
                  {letra}
                </span>
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

</header>

<style>
  /* Registrar os raios como <length> permite interpolá-los na animação. */
  @property --glow-1 {
    syntax: "<length>";
    inherits: false;
    initial-value: 5px;
  }
  @property --glow-2 {
    syntax: "<length>";
    inherits: false;
    initial-value: 16px;
  }
  @property --glow-3 {
    syntax: "<length>";
    inherits: false;
    initial-value: 40px;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ff3f0a;
    overflow: hidden;
  }

  .hero__nome {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    padding-bottom: 0;
  }

  /* O nome legível fica só para leitores de tela; o desenho é decorativo. */
  .hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__wordmark {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 0.06em;
    font-family: Anton, Impact, "Arial Black", "Helvetica Neue", sans-serif;
    font-size: 20vw;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: #f4f0e8;
    --glow-1: 5px;
    --glow-2: 16px;
    --glow-3: 40px;
    filter: drop-shadow(0 0 var(--glow-1) rgba(255, 255, 255, 0.7))
      drop-shadow(0 0 var(--glow-2) rgba(255, 255, 255, 0.4))
      drop-shadow(0 0 var(--glow-3) rgba(255, 255, 255, 0.2));
    transform-origin: 50% 100%;
    animation:
      flash 0.9s cubic-bezier(0.33, 1, 0.68, 1) 0.78s both,
      impacto 0.5s cubic-bezier(0.22, 1.4, 0.36, 1) 0.86s both,
      glow 8.5s cubic-bezier(0.37, 0, 0.63, 1) 1.9s infinite;
    will-change: filter, scale;
    /* sangra pela borda de baixo: o nome parece sair da tela.
       Só um fio das letras fica de fora — cortar mais que isso descaracteriza
       os glifos (o C e o O viram formas achatadas). */
    margin-bottom: -0.04em;
  }

  .hero__palavra {
    display: flex;
  }

  /* Cada letra sobe de dentro da própria máscara. */
  .hero__mascara {
    display: block;
    overflow: hidden;
    /* espaço para as descidas do glifo não serem cortadas */
    padding-bottom: 0.08em;
  }

  .hero__letra {
    display: block;
    position: relative;
    translate: 0 105%;
    /* overshoot: a letra passa do lugar e volta — é o que dá o soco */
    animation: revelar 0.72s cubic-bezier(0.16, 1.42, 0.32, 1)
      calc(0.25s + var(--ordem) * 0.04s) both;
  }

  /* rastro: um fantasma da própria letra que sobe atrás e some */
  .hero__letra::before {
    content: attr(data-l);
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: rastro 0.72s ease-out
      calc(0.29s + var(--ordem) * 0.04s) both;
  }

  @keyframes revelar {
    to {
      translate: 0 0;
    }
  }

  @keyframes rastro {
    0% {
      opacity: 0;
      translate: 0 40%;
    }
    25% {
      opacity: 0.34;
    }
    100% {
      opacity: 0;
      translate: 0 0;
    }
  }

  /* pulso do conjunto no instante em que a última letra assenta */
  @keyframes impacto {
    0% {
      scale: 1;
    }
    35% {
      scale: 1.028 0.972;
    }
    100% {
      scale: 1;
    }
  }

  /* estouro do glow junto do impacto */
  @keyframes flash {
    0% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
    30% {
      --glow-1: 34px;
      --glow-2: 104px;
      --glow-3: 210px;
    }
    100% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
  }

  @keyframes glow {
    0%,
    100% {
      --glow-1: 5px;
      --glow-2: 16px;
      --glow-3: 40px;
    }
    50% {
      --glow-1: 26px;
      --glow-2: 82px;
      --glow-3: 176px;
    }
  }

  /* Telas estreitas: uma palavra por linha, cada uma preenchendo a largura. */
  @media (max-width: 48rem) {
    .hero__wordmark {
      flex-direction: column;
      align-items: stretch;
      font-size: 26vw;
      row-gap: 0.02em;
    }

    .hero__palavra {
      justify-content: space-between;
    }

    .hero__palavra--4 {
      font-size: 2.02em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__wordmark {
      animation: none;
    }
    .hero__letra {
      animation: none;
      translate: 0 0;
    }
    .hero__letra::before {
      content: none;
    }
  }

</style>
